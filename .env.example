# Local development template. Copy to .env and supply values privately.
JOBSCOPE_ENV=development
JOBSCOPE_HOST=127.0.0.1
JOBSCOPE_PORT=8000
JOBSCOPE_LOG_LEVEL=INFO

# PostgreSQL is required when storage and memory are enabled.
JOBSCOPE_STORAGE_BACKEND=postgres
JOBSCOPE_DB_HOST=127.0.0.1
JOBSCOPE_DB_PORT=5432
JOBSCOPE_DB_NAME=jobscope
JOBSCOPE_DB_USER=jobscope_app
JOBSCOPE_DB_PASSWORD=<replace-with-local-password>

# Grounded answer generation.
JOBSCOPE_ANSWER_GENERATION_ENABLED=false
JOBSCOPE_ANSWER_MODEL_NAME=qwen-plus
JOBSCOPE_ANSWER_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
JOBSCOPE_ANSWER_MODEL_API_KEY_ENV=DASHSCOPE_API_KEY
JOBSCOPE_ANSWER_MODEL_TIMEOUT_SECONDS=20
JOBSCOPE_ANSWER_MODEL_MAX_COMPLETION_TOKENS=800

# Bounded Job Agent, browser session and request harness.
JOBSCOPE_JOB_AGENT_ENABLED=true
JOBSCOPE_JOB_AGENT_SESSION_TTL_SECONDS=28800
JOBSCOPE_JOB_AGENT_SESSION_COOKIE_SECURE=false
JOBSCOPE_JOB_AGENT_HARNESS_MAX_MODEL_CALLS=3
JOBSCOPE_JOB_AGENT_HARNESS_MAX_TOOL_CALLS=4
JOBSCOPE_JOB_AGENT_HARNESS_MAX_ELAPSED_SECONDS=30
JOBSCOPE_JOB_AGENT_PLANNER_MAX_ATTEMPTS=2
JOBSCOPE_JOB_AGENT_PLANNER_INITIAL_BACKOFF_SECONDS=0.1

# Keep the actual key only in your ignored .env or deployment secret manager.
DASHSCOPE_API_KEY=<replace-with-private-key>
JOBSCOPE_CORS_ALLOWED_ORIGINS=http://localhost:5173
